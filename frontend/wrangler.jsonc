{
  // Cloudflare Workers static-assets config for the Jobyn frontend (Vite SPA).
  // Root directory in the Cloudflare build is `frontend`, so `./dist` is relative to it.
  "name": "jobyn",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown routes so client-side React Router works.
    "not_found_handling": "single-page-application",
    // Prerendered routes are written as <route>/index.html. Without this,
    // Cloudflare serves them at "/route/" and 308-redirects "/route" → "/route/",
    // but our sitemap, canonical tags, and internal <Link>s all use the
    // no-slash form. drop-trailing-slash serves them at "/route" (200) and
    // redirects "/route/" → "/route", keeping every URL consistent.
    "html_handling": "drop-trailing-slash"
  }
}
